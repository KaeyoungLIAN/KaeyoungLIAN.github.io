---
layout: null
permalink: /works.json
---

[{% for work in site.works %}
  {
    "title": {{ work.title | jsonify }},
    "description": {{ work.description | jsonify }},
    "url": "{{ work.url | relative_url }}",
    "tech": {{ work.tech | jsonify }},
    "tags": {{ work.tags | jsonify }},
    "date": "{{ work.date | date: '%Y-%m-%d' }}"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}]
